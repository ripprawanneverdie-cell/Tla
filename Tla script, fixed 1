-- Core Gameplay Utility Functions
local function isStandSummoned()
    local usersFolder = workspace:FindFirstChild("Users")
    if not usersFolder then return false end
    
    local myPlayerNode = usersFolder:FindFirstChild(LocalPlayer.Name)
    local myStand = myPlayerNode and myPlayerNode:FindFirstChild("Stand")
    if not myStand then return false end
    
    local parts = 0
    for _, part in ipairs(myStand:GetDescendants()) do
        if part:IsA("BasePart") and part.Transparency < 1 then
            parts = parts + 1
            if parts > 3 then return true end
        end
    end
    return false
end

local function fireInputRemote(args)
    local remote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Input")
    if remote then
        pcall(function() remote:FireServer(unpack(args)) end)
    end
end

-- Dedicated Autofarm Loop (30 FPS Cap to Prevent Mobile Overheating)
local mobPriorityList = {}
local activeTargetInstance = nil

local function getValidMobs()
    local mobs = {}
    local users = workspace:FindFirstChild("Users")
    if users then
        for _, v in pairs(users:GetChildren()) do
            if v:FindFirstChild("AI") and not table.find(mobs, v.Name) then
                table.insert(mobs, v.Name)
            end
        end
    end
    if #mobs == 0 then table.insert(mobs, "None") end
    return mobs
end

local function getTargetMob()
    if activeTargetInstance and activeTargetInstance.Parent then
        local hum = activeTargetInstance:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then return activeTargetInstance end
    end
    
    activeTargetInstance = nil
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local closest, minDist = nil, math.huge
    local users = workspace:FindFirstChild("Users")
    if users then
        for _, v in pairs(users:GetChildren()) do
            if v:FindFirstChild("AI") then
                local targetHrp = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
                local hum = v:FindFirstChild("Humanoid")
                if targetHrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - targetHrp.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = v
                    end
                end
            end
        end
    end
    activeTargetInstance = closest
    return closest
end

-- Mobile Optimized Main Loop
task.spawn(function()
    local lastTick = os.clock()
    while true do
        task.wait(0.033) -- ~30 FPS loop to preserve battery and prevent crash
        
        if getgenv().autoMobFarm or getgenv().autoMobFarmAll then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            if hrp then
                local target = getTargetMob()
                if target then
                    local targetHrp = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
                    if targetHrp then
                        local dist = Options.MobFarmDistance.Value
                        local hoverPos = targetHrp.Position + Vector3.new(0, dist, 0)
                        hrp.CFrame = CFrame.new(hoverPos) * CFrame.Angles(math.rad(-90), 0, 0)
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        end
        
        -- Auto Actions
        if getgenv().autoSummonEnabled and not isStandSummoned() then
            fireInputRemote({Enum.KeyCode.Q, true})
        end
        
        if getgenv().autoAttackEnabled and isStandSummoned() then
            fireInputRemote({Enum.UserInputType.MouseButton1, true})
        end
        
        if getgenv().autoMovesEnabled and isStandSummoned() and Options.SelectedMoves.Value then
            for key, isSelected in pairs(Options.SelectedMoves.Value) do
                if isSelected then
                    pcall(function() fireInputRemote({Enum.KeyCode[key], true}) end)
                end
            end
        end
    end
end)

